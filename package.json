{
  "name": "genoidt",
  "version": "1.0.0",
  "description": "Genoid desktop companion",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev:ui": "vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently \"npm:dev:ui\" \"wait-on http://localhost:5173 && npm:dev:electron\"",
    "build": "vite build",
    "start": "electron ."
  },
